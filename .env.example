[TEMPLATE]
# ===========================================================================
# PulseAI environment configuration (copy to .env and adjust)
# ===========================================================================

# --- PostgreSQL --------------------------------------------------------------
# Values match the docker-compose stack (host machine sees postgres on 5434).
POSTGRES_USER=pulse_admin
POSTGRES_PASSWORD=pulse_password_123
POSTGRES_DB=pulseai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
# SQLAlchemy driver: postgresql (sync, default) | postgresql+asyncpg (async option)
POSTGRES_DRIVER=postgresql

# --- Qdrant ------------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage ----------------------------------------------------------
# local (filesystem) for development; s3 for Supabase Storage / MinIO / AWS.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage/objects
# Only needed when STORAGE_BACKEND=s3 (plus `pip install pulseai[storage-s3]`):
# STORAGE_S3_BUCKET=pulseai-articles
# STORAGE_S3_REGION=us-east-1

# --- Application -------------------------------------------------------------
ENVIRONMENT=development   # development | staging | production
DEBUG=false
# Seed the three demo RSS sources on startup (development convenience).
SEED_DEFAULT_SOURCES=true
# How often the scheduler process scans for due sources.
SCHEDULER_TICK_SECONDS=30
