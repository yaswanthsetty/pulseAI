# ===========================================================================
# PulseAI environment configuration (copy to .env and adjust)
# ===========================================================================

# --- PostgreSQL --------------------------------------------------------------
# Values match the docker-compose stack (host machine sees postgres on 5434).
POSTGRES_USER=pulse_admin
POSTGRES_PASSWORD=pulse_password_123
POSTGRES_DB=pulseai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
# SQLAlchemy driver: postgresql (sync, default) | postgresql+asyncpg (async option)
POSTGRES_DRIVER=postgresql

# --- Qdrant ------------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage ----------------------------------------------------------
# local (filesystem) for development; s3 for Supabase Storage / MinIO / AWS.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage/objects
# Only needed when STORAGE_BACKEND=s3 (plus `pip install pulseai[storage-s3]`):
# STORAGE_S3_BUCKET=pulseai-articles
# STORAGE_S3_REGION=us-east-1

# --- Auth (Phase 1.5) --------------------------------------------------------
# none (local register/login) | clerk | auth0  — spec §21
AUTH_PROVIDER=none
# Local-mode JWT signing key. MUST be a strong secret in any real deployment.
JWT_SECRET=dev-only-secret-change-me
JWT_ISSUER=pulseai
JWT_AUDIENCE=pulseai-api
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
# Managed-provider settings (only when AUTH_PROVIDER=clerk|auth0):
# CLERK_DOMAIN=your-clerk-domain.clerk.accounts.dev
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_AUDIENCE=https://pulseai-api
# Cookies: enable COOKIE_SECURE=true behind HTTPS (HSTS territory, spec §23).
COOKIE_SECURE=false
CSRF_ENABLED=true

# --- Rate limiting (spec §19/§23) — Redis sliding window ---------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANON_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=120
RATE_LIMIT_CHAT_PER_MINUTE=10   # chat/reports endpoints (Phase 5)

# --- Embeddings (Phase 2) ----------------------------------------------------
# How often the scheduler re-enqueues embed jobs for articles still missing
# embedded chunks (spec §11 reconciliation; defaults to 60 minutes).
# EMBEDDING_RECONCILE_INTERVAL_MINUTES=60

# --- Rerank (FR-13) ----------------------------------------------------------
# Cross-encoder reranks the top-K retrieved candidates to the final top-N.
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANK_ENABLED=true
# RERANK_TOP_K=50
# RERANK_TOP_N=10

# --- Events / clustering (Phase 3, spec §14) ---------------------------------
# QDRANT_ARTICLES_COLLECTION=pulseai_articles
# QDRANT_EVENT_CENTROIDS_COLLECTION=pulseai_event_centroids
# EVENT_MATCH_THRESHOLD=0.72        # fast-path cosine threshold (FR-18);
#                                   # spec suggests 0.82, but BGE-M3 centroids
#                                   # measure ~80% recall at 0.72
# EVENT_SLOW_PATH_WINDOW_HOURS=6    # bounded recent window for UMAP+HDBSCAN
# EVENT_SLOW_PATH_INTERVAL_MINUTES=30  # scheduler cadence for the slow path
# EVENT_MIN_CLUSTER_SIZE=3
# EVENT_CLOSE_HOURS=72              # close events idle this long (FR-17)
# EVENT_UMAP_COMPONENTS=5

# --- Application -------------------------------------------------------------
ENVIRONMENT=development   # development | staging | production
DEBUG=false
# Seed the three demo RSS sources on startup (development convenience).
SEED_DEFAULT_SOURCES=true
# How often the scheduler process scans for due sources.
SCHEDULER_TICK_SECONDS=30
