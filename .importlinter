# Module-boundary enforcement (spec §8).
#
# Three rules keep the modular monolith honest:
#   1. `modules/api` is the top layer — nothing else may import from it.
#   2. Business modules are independent — no sibling imports.
#   3. `modules/auth` is shared cross-cutting infrastructure (its
#      require_role/get_current_user/rate-limit dependencies are used by every
#      route) — business modules MAY import it, but auth never imports them.

[importlinter]
root_package = backend
# Type-only imports (under ``if TYPE_CHECKING``) never couple modules at
# runtime, so they are excluded rather than ignored contract by contract.
exclude_type_checking_imports = true

[importlinter:contract:1]
name = API is the top layer (nothing imports modules.api)
type = forbidden
source_modules =
    backend.modules.retrieval
    backend.modules.ranking
    backend.modules.events
    backend.modules.agents
    backend.modules.auth
    backend.modules.reports
    backend.modules.ingestion
forbidden_modules =
    backend.modules.api

[importlinter:contract:2]
name = Business modules are independent (no sibling imports)
type = independence
modules =
    backend.modules.retrieval
    backend.modules.ranking
    backend.modules.events
    backend.modules.agents
    backend.modules.reports
    backend.modules.ingestion
    backend.modules.library
    backend.modules.insights
ignore_imports =
    # ``backend.core.queue`` is the RQ wiring hub (spec §12): it registers each
    # phase's jobs via deferred imports so business modules never import each
    # other — ingestion triggers the Phase 2 ``embed`` job and the Phase 3
    # ``cluster`` job only through this hub.
    backend.core.queue -> backend.modules.ingestion.jobs
    backend.core.queue -> backend.modules.retrieval.jobs
    backend.core.queue -> backend.modules.events.jobs
    # FR-14/15: retrieval composes the ranking module's pure scoring functions
    # (ranking stays retrieval-agnostic — it accepts generic candidates).
    backend.modules.retrieval.service -> backend.modules.ranking.service
    # agents/router.py is the integration layer (spec §8): it fetches retrieval
    # context and injects it into the pure agents service. agents/service.py
    # itself only type-imports SearchResult (covered by
    # exclude_type_checking_imports above).
    backend.modules.agents.router -> backend.modules.retrieval.service

[importlinter:contract:3]
name = Auth is shared infrastructure (only API and business modules import it)
type = protected
protected_modules =
    backend.modules.auth
allowed_importers =
    backend.main
    backend.modules.api
    backend.modules.retrieval
    backend.modules.ranking
    backend.modules.events
    backend.modules.agents
    backend.modules.reports
    backend.modules.ingestion
    backend.modules.library
    backend.modules.insights

[importlinter:contract:4]
name = Auth never imports business modules
type = forbidden
source_modules =
    backend.modules.auth
forbidden_modules =
    backend.modules.retrieval
    backend.modules.ranking
    backend.modules.events
    backend.modules.agents
    backend.modules.reports
    backend.modules.ingestion
